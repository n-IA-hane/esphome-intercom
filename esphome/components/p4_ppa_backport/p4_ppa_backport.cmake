# Official ESP-IDF PPA fixes for engine admission and rotated SRM completion.
# Build-local copies only. Preserve the original component target and public API.
include_guard(GLOBAL)

function(_esphome_p4_ppa_backport)
    idf_build_get_property(_target IDF_TARGET)
    if(NOT _target STREQUAL "esp32p4" OR BOOTLOADER_BUILD)
        return()
    endif()
    idf_build_get_property(_idf_path IDF_PATH)
    include("${_idf_path}/tools/cmake/version.cmake")
    set(_version "${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}.${IDF_VERSION_PATCH}")
    if(NOT _version STREQUAL "5.5.6" AND NOT _version STREQUAL "6.0.3")
        return()
    endif()
    set(_helper "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    file(READ "${_helper}/p4_ppa_backport.json" _manifest)
    set(_base "${_manifest}")
    if(_version STREQUAL "6.0.3")
        string(JSON _base GET "${_manifest}" additional_bases "${_version}")
    endif()
    string(JSON _rotation_patch GET "${_base}" rotation_patch_file)
    string(JSON _engine_sha GET "${_manifest}" patch_sha256)
    string(JSON _rotation_sha GET "${_base}" rotation_patch_sha256)
    find_package(Git REQUIRED)
    get_filename_component(_idf_parent "${_idf_path}" DIRECTORY)
    set(_patch_files "9da8ff53.patch" "${_rotation_patch}")
    set(_patch_hashes "${_engine_sha}" "${_rotation_sha}")
    set(_missing_patches "")
    foreach(_patch _expected IN ZIP_LISTS _patch_files _patch_hashes)
        file(SHA256 "${_helper}/${_patch}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "P4 PPA backport: official patch checksum mismatch for ${_patch}")
        endif()
        # Recognize each official fix independently on an SDK that already carries one or both.
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE
            --unset=GIT_INDEX_FILE "GIT_CEILING_DIRECTORIES=${_idf_parent}"
            "${GIT_EXECUTABLE}" apply --reverse --check "${_helper}/${_patch}"
            WORKING_DIRECTORY "${_idf_path}" RESULT_VARIABLE _fixed OUTPUT_QUIET ERROR_QUIET)
        if(NOT _fixed EQUAL 0)
            list(APPEND _missing_patches "${_helper}/${_patch}")
        endif()
    endforeach()
    if(NOT _missing_patches)
        message(STATUS "P4 PPA backport skipped: both official fixes already present")
        return()
    endif()

    set(_copy_root "${CMAKE_BINARY_DIR}/p4_ppa_backport")
    get_filename_component(_copy_parent "${_copy_root}" DIRECTORY)
    set(_copy_ready TRUE)
    string(JSON _length LENGTH "${_base}" files)
    math(EXPR _last "${_length} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _path GET "${_base}" files ${_index} path)
        string(JSON _before GET "${_base}" files ${_index} sha256)
        if(NOT EXISTS "${_idf_path}/${_path}")
            message(FATAL_ERROR "P4 PPA backport: missing SDK source ${_path}")
        endif()
        file(SHA256 "${_idf_path}/${_path}" _sha)
        string(JSON _after GET "${_base}" files ${_index} patched_sha256)
        set(_known_hashes "${_before}" "${_after}")
        if(_path MATCHES "/ppa_srm[.]c$")
            # Both patches touch this file; accept either verified intermediate.
            foreach(_key engine_only_sha256 rotation_only_sha256)
                string(JSON _partial GET "${_base}" files ${_index} "${_key}")
                list(APPEND _known_hashes "${_partial}")
            endforeach()
        endif()
        if(NOT _sha IN_LIST _known_hashes)
            message(FATAL_ERROR "P4 PPA backport: unrecognized SDK source ${_path}, SHA256 ${_sha}; no replacement written")
        endif()
        set(_sha "")
        if(EXISTS "${_copy_root}/${_path}")
            file(SHA256 "${_copy_root}/${_path}" _sha)
        endif()
        if(NOT _sha STREQUAL _after)
            set(_copy_ready FALSE)
        endif()
    endforeach()

    idf_component_get_property(_library esp_driver_ppa COMPONENT_LIB)
    if(NOT TARGET "${_library}")
        message(FATAL_ERROR "P4 PPA backport: original component target is missing")
    endif()
    get_target_property(_sources "${_library}" SOURCES)
    set(_replaced "${_sources}")
    foreach(_name ppa_blend.c ppa_core.c ppa_fill.c ppa_srm.c)
        set(_original "${_idf_path}/components/esp_driver_ppa/src/${_name}")
        set(_copy "${_copy_root}/components/esp_driver_ppa/src/${_name}")
        set(_count 0)
        foreach(_source IN LISTS _sources)
            if(_source STREQUAL _original OR _source STREQUAL _copy)
                math(EXPR _count "${_count} + 1")
            endif()
        endforeach()
        if(NOT _count EQUAL 1)
            message(FATAL_ERROR "P4 PPA backport: expected one ${_name} source, found ${_count}")
        endif()
        foreach(_property COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FLAGS INCLUDE_DIRECTORIES
                          LANGUAGE OBJECT_DEPENDS OBJECT_OUTPUTS HEADER_FILE_ONLY
                          SKIP_PRECOMPILE_HEADERS SKIP_UNITY_BUILD_INCLUSION)
            get_source_file_property(_value "${_original}" TARGET_DIRECTORY "${_library}" "${_property}")
            if(NOT _value STREQUAL "NOTFOUND")
                set_source_files_properties("${_copy}" TARGET_DIRECTORY "${_library}"
                    PROPERTIES "${_property}" "${_value}")
            endif()
        endforeach()
        list(FIND _replaced "${_original}" _position)
        if(NOT _position EQUAL -1)
            list(REMOVE_AT _replaced ${_position})
            list(INSERT _replaced ${_position} "${_copy}")
        endif()
    endforeach()
    if(NOT _copy_ready)
        foreach(_index RANGE 0 ${_last})
            string(JSON _path GET "${_base}" files ${_index} path)
            get_filename_component(_directory "${_copy_root}/${_path}" DIRECTORY)
            file(MAKE_DIRECTORY "${_directory}")
            configure_file("${_idf_path}/${_path}" "${_copy_root}/${_path}" COPYONLY)
        endforeach()
        foreach(_mode --check --apply)
            set(_args "")
            if(_mode STREQUAL "--check")
                set(_args --check)
            endif()
            execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE
                --unset=GIT_INDEX_FILE "GIT_CEILING_DIRECTORIES=${_copy_parent}"
                "${GIT_EXECUTABLE}" apply ${_args} ${_missing_patches}
                WORKING_DIRECTORY "${_copy_root}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "P4 PPA backport: official patch rejected: ${_error}")
            endif()
        endforeach()
    endif()
    foreach(_index RANGE 0 ${_last})
        string(JSON _path GET "${_base}" files ${_index} path)
        string(JSON _after GET "${_base}" files ${_index} patched_sha256)
        file(SHA256 "${_copy_root}/${_path}" _sha)
        if(NOT _sha STREQUAL _after)
            message(FATAL_ERROR "P4 PPA backport: patched checksum mismatch for ${_path}")
        endif()
    endforeach()
    set_property(TARGET "${_library}" PROPERTY SOURCES "${_replaced}")
    message(STATUS "P4 PPA official fixes: applied to four build-local sources and private header")
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" ID esphome_p4_ppa_backport
    CALL _esphome_p4_ppa_backport)
